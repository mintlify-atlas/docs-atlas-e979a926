{
  "projectType": "frontend",
  "projectName": "WidevineProxy2",
  "projectDescription": "A browser extension (Chrome & Firefox) that intercepts and proxies Widevine/ClearKey EME license challenges, extracting decryption keys by re-signing requests with a local or remote CDM device.",
  "theme": "luma",
  "primaryColor": "#8c8c8b",
  "lightColor": "#21313f",
  "darkColor": "#cccccb",
